{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated creator account profile stored privately per user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google email address",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Creator display name",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "description": "Profile photo URL",
          "maxLength": 500
        },
        "authProvider": {
          "type": "string",
          "enum": ["google.com"],
          "description": "Authentication provider"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last sign-in or profile update timestamp"
        }
      },
      "required": ["uid", "email", "displayName", "authProvider", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private creator user profile documents isolated by owner UID."
    }
  }
}
